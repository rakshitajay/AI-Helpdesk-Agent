# ============================================================
# AI Helpdesk Agent - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Google Gemini API ---
GOOGLE_API_KEY=your_google_gemini_api_key_here

# --- JWT Authentication ---
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database ---
DATABASE_URL=sqlite:///./backend/database/helpdesk.db

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./backend/vector_db/chroma_store
CHROMA_COLLECTION_NAME=helpdesk_docs

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# --- File Upload ---
UPLOAD_DIR=./backend/documents/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt

# --- RAG Settings ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5
EMBEDDING_MODEL=models/embedding-001
GEMINI_MODEL=gemini-2.5-flash

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=30

# --- Admin ---
ADMIN_EMAIL=admin@helpdesk.ai
ADMIN_PASSWORD=Admin@123456

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./backend/logs/app.log

# --- App ---
APP_NAME=AI Helpdesk Agent
APP_VERSION=1.0.0
DEBUG=false
